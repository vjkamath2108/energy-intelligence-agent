# AWS
AWS_REGION=eu-west-2
AWS_PROFILE=vijay-dev

# Bedrock model (us-west-2 requires regional inference profile prefix)
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0

# Database (EIA core) — connect via SSM tunnel: ./infra/ssm_tunnel.sh
DB_HOST=localhost
DB_PORT=5432
DB_NAME=energy_db
DB_USER=energy_user
DB_PASSWORD=your_password_here
# require = SSL on, no cert verification (dev tunnel) | disable = plain TCP
DB_SSLMODE=require

# Ollama (sovereign / dev mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
